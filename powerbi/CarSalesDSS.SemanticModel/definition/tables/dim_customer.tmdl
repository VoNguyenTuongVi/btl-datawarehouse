		lineageTag: 3d6938dc-6312-410b-8c14-d37ec093642d

	column 'income_quartile' =
			VAR _i = dim_customer[annual_income]
			VAR _q1 = PERCENTILEX.INC ( ALL ( dim_customer ), dim_customer[annual_income], 0.25 )
			VAR _q2 = PERCENTILEX.INC ( ALL ( dim_customer ), dim_customer[annual_income], 0.5 )
			VAR _q3 = PERCENTILEX.INC ( ALL ( dim_customer ), dim_customer[annual_income], 0.75 )
			RETURN
			    IF ( ISBLANK ( _i ), BLANK (), IF ( _i <= _q1, 1, IF ( _i <= _q2, 2, IF ( _i <= _q3, 3, 4 ) ) ) )
		dataType: int64
		summarizeBy: none
		lineageTag: 69903525-b91d-40e1-ad0d-12a3d669a959

	partition 'dim_customer' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = PgSchema, Item = "dim_customer"]}[Data],
				    Selected = Table.SelectColumns(Data, {"customer_id", "customer_name", "gender", "annual_income", "phone"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"customer_id", Int64.Type}, {"customer_name", type text}, {"gender", type text}, {"annual_income", Int64.Type}, {"phone", type text}})
				in
				    Typed
