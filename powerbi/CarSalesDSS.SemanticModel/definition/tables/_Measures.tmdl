	measure 'DQ Checks Passed' = COUNTROWS ( FILTER ( dq_checks, dq_checks[passed] = TRUE () ) )
		formatString: 0
		displayFolder: 6. Chất lượng dữ liệu
		lineageTag: 7c02c834-4491-4011-9f47-5003ce4076b0

	/// Q1–Q6
	measure 'DQ Pass Rate' = DIVIDE ( [DQ Checks Passed], COUNTROWS ( dq_checks ) )
		formatString: 0.0%
		displayFolder: 6. Chất lượng dữ liệu
		lineageTag: 99db92bd-06a0-4def-a42b-b69dc00728ee

	/// CV sản lượng theo tháng lịch sử; giữ lọc hãng/vùng, bỏ lọc thời gian
	measure 'Demand CV Hist' =
			VAR monthly =
			    CALCULATETABLE(
			        FILTER(
			            ADDCOLUMNS(
			                VALUES(dim_month[year_month]),
			                "__dss_units", [Fact Units]
			            ),
			            [__dss_units] > 0
			        ),
			        REMOVEFILTERS(dim_month),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_calendar),
			        REMOVEFILTERS(dim_year)
			    )
			RETURN IF(
			    COUNTROWS(monthly) < 2, BLANK(),
			    DIVIDE(
			        STDEVX.P(monthly, [__dss_units]),
			        AVERAGEX(monthly, [__dss_units])
			    )
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: 49d306f3-9e45-481c-b9bb-91d9d144e2a4

	/// ASP lịch sử từ fact; giữ lọc hãng/vùng, bỏ lọc thời gian
	measure 'ASP Hist' =
			CALCULATE(
			    [Fact ASP],
			    REMOVEFILTERS(dim_month),
			    REMOVEFILTERS(dim_date),
			    REMOVEFILTERS(dim_calendar),
			    REMOVEFILTERS(dim_year)
			)
		formatString: $#,0
		displayFolder: 8. DSS S5/S6
		lineageTag: f2696995-efdd-4bd1-81ad-1a1eceabc2eb

	/// CV lịch sử của đúng hãng/vùng đang được chọn trong forecast
	measure 'Demand CV for Member' =
			VAR levelName = SELECTEDVALUE(fact_demand_forecast[level], "total")
			RETURN SWITCH(
			    levelName,
			    "company", CALCULATE(
			        [Demand CV Hist],
			        TREATAS(VALUES(fact_demand_forecast[member]), dim_car[company])
			    ),
			    "region", CALCULATE(
			        [Demand CV Hist],
			        TREATAS(VALUES(fact_demand_forecast[member]), dim_dealer[dealer_region])
			    ),
			    [Demand CV Hist]
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: c491ed80-c50c-43f4-9f30-8dc56032e397

	/// ASP lịch sử của đúng hãng/vùng đang được chọn trong forecast
	measure 'ASP for Member' =
			VAR levelName = SELECTEDVALUE(fact_demand_forecast[level], "total")
			RETURN SWITCH(
			    levelName,
			    "company", CALCULATE(
			        [ASP Hist],
			        TREATAS(VALUES(fact_demand_forecast[member]), dim_car[company])
			    ),
			    "region", CALCULATE(
			        [ASP Hist],
			        TREATAS(VALUES(fact_demand_forecast[member]), dim_dealer[dealer_region])
			    ),
			    [ASP Hist]
			)
		formatString: $#,0
