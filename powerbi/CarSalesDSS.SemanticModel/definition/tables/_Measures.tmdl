	/// D5, D6, D12–D17 – tỷ trọng trong chiều đang chọn
	measure 'Dim Units Share %' =
			DIVIDE (
			    [Dim Units],
			    CALCULATE ( [Dim Units], ALLSELECTED ( dim_member[dimension_value], dim_member[parent_value] ) )
			)
		formatString: 0.0%
		displayFolder: 2. Theo chiều phân tích
		lineageTag: f44495f5-4222-4cd1-bcd3-b37888af16ef

	/// D16 – xếp hạng theo sản lượng
	measure 'Dim Rank' = IF ( NOT ISBLANK ( [Dim Units] ), RANKX ( ALLSELECTED ( dim_member[dimension_value] ), [Dim Units] ) )
		formatString: 0
		displayFolder: 2. Theo chiều phân tích
		lineageTag: bb25bee2-ec30-4ae7-b13e-20ea3a0eb2c6

