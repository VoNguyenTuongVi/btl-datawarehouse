table _Measures
	lineageTag: 54999c59-4f22-48f6-a519-3c36227d3221

	/// D1 – Sản lượng bán
	measure 'Units Sold' = SUM ( fact_car_sales[quantity] )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: ce7f6b6d-7d95-40ef-9bb8-888a253755ac

	/// D2 – Doanh thu
	measure Revenue = SUM ( fact_car_sales[price] )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 0579b3f1-d7b4-4d82-abf7-04f2a326753b

	/// D3 – Giá bán bình quân
	measure ASP = DIVIDE ( [Revenue], [Units Sold] )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 38a74b8e-b3ef-4e55-acc2-4db75855a26f

	measure 'Units PM' = CALCULATE ( [Units Sold], DATEADD ( Calendar[Date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 6dd0386e-d553-496a-b1b1-bfb7c5c91ba8

	measure 'Units PQ' = CALCULATE ( [Units Sold], DATEADD ( Calendar[Date], -1, QUARTER ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 1404c431-7b6a-4e0d-8535-06a884f3be78

	measure 'Units PY' = CALCULATE ( [Units Sold], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 4c72d8d1-6ef2-4a0c-9ca6-30075dc0bab2

	measure 'Revenue PM' = CALCULATE ( [Revenue], DATEADD ( Calendar[Date], -1, MONTH ) )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 650b41e6-71be-4b77-bc6a-4c1b73bc4acd

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: e9249e7f-382a-4efd-b308-27034c42cf9a

	/// D4
	measure 'Units MoM %' = DIVIDE ( [Units Sold] - [Units PM], [Units PM] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: e5e3b21e-d0a5-4f7f-b982-6725c387c1bd

	/// D4
	measure 'Units QoQ %' = DIVIDE ( [Units Sold] - [Units PQ], [Units PQ] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 9b1814d0-1d37-490f-858c-6c527d9a70f5

	/// D4
	measure 'Units YoY %' = DIVIDE ( [Units Sold] - [Units PY], [Units PY] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: ab1c836f-2ba2-4512-95e5-a2de0ba54ebd

	/// D4
	measure 'Revenue MoM %' = DIVIDE ( [Revenue] - [Revenue PM], [Revenue PM] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 80a4169c-5e26-4b5b-8a0d-a78cb46e33d0

	/// D4
	measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 41626fa3-cfeb-42fa-b5b0-1c9f6a8630eb

	/// D4
	measure 'Units YTD' = TOTALYTD ( [Units Sold], Calendar[Date] )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 99ac4763-aedf-4d12-aab0-aa3b3b132763

	/// D4
	measure 'Revenue YTD' = TOTALYTD ( [Revenue], Calendar[Date] )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: bff72949-a1f4-4889-8d0a-8ffa8bb0a407

	/// D4
	measure 'Revenue YTD YoY %' =
			VAR _py = CALCULATE ( [Revenue YTD], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
			RETURN DIVIDE ( [Revenue YTD] - _py, _py )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 0d0b86cf-90a1-44ab-94e5-efae14b2f7f8

	/// D5, D12, D14, D15 – tỷ trọng theo thuộc tính xe
	measure 'Units Share %' = DIVIDE ( [Units Sold], CALCULATE ( [Units Sold], ALLSELECTED ( dim_car ) ) )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 6cc0b8ea-6ad2-4ec8-861d-dfa1ec0f5c34

	/// D6
	measure 'Region Share %' = DIVIDE ( [Units Sold], CALCULATE ( [Units Sold], ALLSELECTED ( dim_dealer ) ) )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: a2b3a90f-4e31-4b45-91af-7564353d19b1

	/// D17
	measure 'Gender Share %' = DIVIDE ( [Units Sold], CALCULATE ( [Units Sold], ALLSELECTED ( dim_customer[gender] ) ) )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 71a9baba-7754-48e4-a5f8-5dc4e2289cea

	/// D7
	measure 'Seasonality Index' =
			DIVIDE (
			    [Units Sold],
			    AVERAGEX ( ALLSELECTED ( Calendar[MonthNo], Calendar[Month] ), [Units Sold] )
			)
		formatString: 0.00
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: efb358fd-243e-4d6f-a408-cf47aa0d386c

	/// D9
	measure 'Demand CV' =
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Calendar[YearMonth] ), "u", [Units Sold] ), [u] > 0 )
			RETURN DIVIDE ( STDEVX.P ( _t, [u] ), AVERAGEX ( _t, [u] ) )
		formatString: 0.000
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 7b44515b-eb0b-4358-b951-d5d76ccfa978

	/// D9 trên toàn bộ lịch sử, dùng cho tháng dự báo
	measure 'Demand CV Hist' = CALCULATE ( [Demand CV], REMOVEFILTERS ( Calendar ) )
		formatString: 0.000
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: ca2af072-3b5a-428c-a519-b7aeb036c82b

	/// D3 trên toàn bộ lịch sử, dùng cho tháng dự báo
	measure 'ASP Hist' = CALCULATE ( [ASP], REMOVEFILTERS ( Calendar ) )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: c008c437-52c3-40d6-b456-ca73624fbc60

	/// D10
	measure 'Top10 Model Share %' =
			DIVIDE (
			    SUMX ( TOPN ( 10, ALLSELECTED ( dim_car[model] ), [Units Sold] ), [Units Sold] ),
			    CALCULATE ( [Units Sold], ALLSELECTED ( dim_car[model] ) )
			)
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 5a7484df-2217-4d5c-862d-a7bef0740ed8

	/// D11
	measure 'Price to Income' =
			AVERAGEX (
			    fact_car_sales,
			    DIVIDE ( fact_car_sales[price], RELATED ( dim_customer[annual_income] ) )
			)
		formatString: 0.00
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 00760cb0-dbe2-4b30-88b8-463d0abdc2b0

	/// D13 – mẫu tăng, giảm mạnh nhất
	measure 'Units YoY Delta' = [Units Sold] - [Units PY]
		formatString: +#,0;-#,0;0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: d9e14fe5-2780-4f52-a022-ded9bb3a88a8

	/// D14
	measure 'Auto Share %' = DIVIDE ( CALCULATE ( [Units Sold], dim_car[transmission] = "Auto" ), [Units Sold] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 17f95f0b-1b6e-4ee8-a2b7-339740b1805f

	/// D14
	measure 'Auto Share Change pp' = [Auto Share %] - CALCULATE ( [Auto Share %], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: b2fa1f37-81b9-49d0-af78-72b6d3c6aaae

	/// D16
	measure 'Dealer Rank' = RANKX ( ALLSELECTED ( dim_dealer[dealer_name] ), [Units Sold] )
		formatString: 0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 4df632ac-7c7c-4da1-8fc1-3ca0345df7d5

	/// D16
	measure 'Units per Dealer per Month' =
			DIVIDE (
			    [Units Sold],
			    DISTINCTCOUNT ( fact_car_sales[dealer_id] ) * DISTINCTCOUNT ( Calendar[YearMonth] )
			)
		formatString: 0.0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 81af714a-a400-4575-9bd4-4d5d825bcb27

	/// D16
	measure 'Dealers Growing %' =
			DIVIDE (
			    COUNTROWS ( FILTER ( VALUES ( dim_dealer[dealer_name] ), [Units YoY %] > 0 ) ),
			    COUNTROWS ( VALUES ( dim_dealer[dealer_name] ) )
			)
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 2e335fab-e2a9-4b71-bb19-05f6d2cb208f

	/// F1 – mặc định mô hình sarima, cấp tổng
	measure 'Forecast Units' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = FALSE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "total" )
			    )
			RETURN SUMX ( _t, fact_demand_forecast[forecast_units] )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: 1af6b9e4-cd94-4541-bfb4-db17a51f63d5

	/// F1 – cận dưới khoảng 80%
	measure 'Forecast Lower' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = FALSE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "total" )
			    )
			RETURN SUMX ( _t, fact_demand_forecast[lower_80] )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: 476eac70-ede1-4563-8935-90d1c0edba7f

	/// F1 – cận trên khoảng 80%
	measure 'Forecast Upper' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = FALSE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "total" )
			    )
			RETURN SUMX ( _t, fact_demand_forecast[upper_80] )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: 24d9d3b5-5bc2-4acd-a3c3-0c7216337d4b

	/// F1 – tháng đầu tiên sau dữ liệu (01/2024)
	measure 'Forecast Next Month' =
			VAR _first =
			    CALCULATE (
			        MIN ( fact_demand_forecast[month_start] ),
			        fact_demand_forecast[is_backtest] = FALSE (),
			        REMOVEFILTERS ( Calendar )
			    )
			RETURN CALCULATE ( [Forecast Units], fact_demand_forecast[month_start] = _first, REMOVEFILTERS ( Calendar ) )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: 18ff56ac-7443-4d77-bf4b-43ce99747c7d

	/// Dự báo cho 6 tháng backtest
	measure 'Backtest Forecast' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN SUMX ( _t, fact_demand_forecast[forecast_units] )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: b40b9145-af2d-404c-8e76-5d2dea12694c

	/// Thực tế của 6 tháng backtest
	measure 'Backtest Actual' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN SUMX ( _t, fact_demand_forecast[actual_units] )
		formatString: #,0
		displayFolder: 3. Dự báo
		lineageTag: cac358d8-7036-45d7-8525-475449687ed2

	/// F3 – mặc định cấp hãng
	measure 'WAPE %' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN DIVIDE (
			    SUMX ( _t, ABS ( fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ) ),
			    SUMX ( _t, fact_demand_forecast[actual_units] )
			)
		formatString: 0.0%
		displayFolder: 3. Dự báo
		lineageTag: e3898e3b-e5f3-4b49-803b-a758276017ef

	/// F3
	measure 'Forecast Accuracy %' = IF ( NOT ISBLANK ( [WAPE %] ), 1 - [WAPE %] )
		formatString: 0.0%
		displayFolder: 3. Dự báo
		lineageTag: cecc954d-f0e6-4156-aa82-4bc9f679521d

	/// F2
	measure 'MAPE %' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN AVERAGEX (
			    _t,
			    DIVIDE ( ABS ( fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ), fact_demand_forecast[actual_units] )
			)
		formatString: 0.0%
		displayFolder: 3. Dự báo
		lineageTag: def479a0-d5a0-4759-a519-cf06392e7c2e

	/// F4
	measure MAE =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN AVERAGEX ( _t, ABS ( fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ) )
		formatString: 0.0
		displayFolder: 3. Dự báo
		lineageTag: aaf79187-32bd-44b1-b73a-60de5675cbdd

	/// F4
	measure RMSE =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN SQRT ( AVERAGEX ( _t, ( fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ) ^ 2 ) )
		formatString: 0.0
		displayFolder: 3. Dự báo
		lineageTag: 2572fae6-8c9c-46db-ad4d-df7933089cfb

	/// F5 – dương là dự báo dư
	measure 'Bias %' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN DIVIDE (
			    SUMX ( _t, fact_demand_forecast[forecast_units] - fact_demand_forecast[actual_units] ),
			    SUMX ( _t, fact_demand_forecast[actual_units] )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Dự báo
		lineageTag: 6c81a292-4939-43cc-8742-9fb7196a5865

	/// F6 – ngoài ±4 là cảnh báo
	measure 'Tracking Signal' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN DIVIDE (
			    SUMX ( _t, fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ),
			    AVERAGEX ( _t, ABS ( fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units] ) )
			)
		formatString: 0.00
		displayFolder: 3. Dự báo
		lineageTag: d91cc7a8-e019-47f2-ae2e-a8b438a068ff

	/// F7 – dương là mô hình tốt hơn seasonal naive
	measure FVA = CALCULATE ( [WAPE %], fact_demand_forecast[model_name] = "seasonal_naive" ) - [WAPE %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Dự báo
		lineageTag: 33114440-8c93-4373-baea-513220d8f546

	/// F8
	measure 'Interval Coverage %' =
			VAR _useModel = NOT ISFILTERED ( fact_demand_forecast[model_name] )
			VAR _useLevel =
			    NOT ISFILTERED ( fact_demand_forecast[level] )
			        && NOT ISFILTERED ( fact_demand_forecast[member] )
			VAR _t =
			    FILTER (
			        fact_demand_forecast,
			        fact_demand_forecast[is_backtest] = TRUE ()
			            && ( NOT _useModel || fact_demand_forecast[model_name] = "sarima" )
			            && ( NOT _useLevel || fact_demand_forecast[level] = "company" )
			    )
			RETURN DIVIDE (
			    COUNTROWS ( FILTER ( _t, fact_demand_forecast[actual_units] >= fact_demand_forecast[lower_80]
			        && fact_demand_forecast[actual_units] <= fact_demand_forecast[upper_80] ) ),
			    COUNTROWS ( _t )
			)
		formatString: 0.0%
		displayFolder: 3. Dự báo
		lineageTag: d1afb42d-a641-4fe4-8534-ba5c1311c20e

	/// Sản lượng thực tế của đúng hãng / vùng trên trục của bảng dự báo
	measure 'Actual Units for Member' =
			VAR _lvl = SELECTEDVALUE ( fact_demand_forecast[level], "total" )
			RETURN
			    SWITCH (
			        _lvl,
			        "company", CALCULATE ( [Units Sold], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_car[company] ) ),
			        "region", CALCULATE ( [Units Sold], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_dealer[dealer_region] ) ),
			        [Units Sold]
			    )
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 1dbdee1a-480c-4c99-9393-f4db7e92f6a8

	/// Sản lượng cùng kỳ năm trước của đúng hãng / vùng
	measure 'Actual Units PY for Member' =
			VAR _lvl = SELECTEDVALUE ( fact_demand_forecast[level], "total" )
			RETURN
			    SWITCH (
			        _lvl,
			        "company", CALCULATE ( [Units PY], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_car[company] ) ),
			        "region", CALCULATE ( [Units PY], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_dealer[dealer_region] ) ),
			        [Units PY]
			    )
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: fb57e7fa-b09f-45d3-9050-08c826e8bf2b

	/// S1
	measure 'Forecast Growth %' = DIVIDE ( [Forecast Units] - [Actual Units PY for Member], [Actual Units PY for Member] )
		formatString: 0.0%
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 8e37b010-e809-41b1-9639-50d657ead574

	/// Tỷ trọng vùng / đại lý trong 6 tháng cuối dataset
	measure 'Region Share 6M %' =
			VAR _lastDay = CALCULATE ( MAX ( fact_car_sales[date_id] ), ALL ( fact_car_sales ) )
			VAR _lastDate = DATE ( INT ( _lastDay / 10000 ), MOD ( INT ( _lastDay / 100 ), 100 ), MOD ( _lastDay, 100 ) )
			VAR _win = DATESINPERIOD ( Calendar[Date], _lastDate, -6, MONTH )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Units Sold], _win, REMOVEFILTERS ( Calendar ) ),
			        CALCULATE ( [Units Sold], _win, REMOVEFILTERS ( Calendar ), ALL ( dim_dealer ) )
			    )
		formatString: 0.0%
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 4429fbae-09ad-4a65-8fa1-ed803239dcc7

	/// S2
	measure 'Allocated Units Next Month' = [Forecast Next Month] * [Region Share 6M %]
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 3c658a34-824a-4247-b7d8-8435635a193a

	measure 'Demand CV for Member' =
			VAR _lvl = SELECTEDVALUE ( fact_demand_forecast[level], "total" )
			RETURN
			    SWITCH (
			        _lvl,
			        "company", CALCULATE ( [Demand CV Hist], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_car[company] ) ),
			        "region", CALCULATE ( [Demand CV Hist], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_dealer[dealer_region] ) ),
			        [Demand CV Hist]
			    )
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 6b22c44f-c94b-4323-bb91-1da00421f51b

	measure 'ASP for Member' =
			VAR _lvl = SELECTEDVALUE ( fact_demand_forecast[level], "total" )
			RETURN
			    SWITCH (
			        _lvl,
			        "company", CALCULATE ( [ASP Hist], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_car[company] ) ),
			        "region", CALCULATE ( [ASP Hist], TREATAS ( VALUES ( fact_demand_forecast[member] ), dim_dealer[dealer_region] ) ),
			        [ASP Hist]
			    )
		formatString: $#,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 10695c99-8fb7-43ab-84c4-84c59687fa07

	/// S3, S6 – có đệm theo độ biến động
	measure 'Recommended Order' = [Forecast Units] * ( 1 + [Demand Change Value] ) * ( 1 + [Safety Factor Value] * [Demand CV for Member] )
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 5d536889-098f-427b-9c49-9f2195b276fb

	/// S4, S6
	measure 'Projected Revenue' = [Forecast Units] * ( 1 + [Demand Change Value] ) * [ASP for Member]
		formatString: $#,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 69128833-7f2c-41e8-ba04-3972812625e7

	/// Mục tiêu tăng trưởng so với cùng kỳ
	measure 'Target Growth' = 0.05
		formatString: 0.0%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: d10ffd71-8e69-46af-b6b5-5690132fba8c

	measure 'WAPE Threshold' = 0.2
		formatString: 0.0%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 62274c35-d12c-4257-816a-6f0eecb5c350

	measure 'Bias Threshold' = 0.05
		formatString: 0.0%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: e063a923-40d8-434a-b5a6-53186ebd41f2

	measure 'Target Units' = IF ( NOT ISBLANK ( [Units PY] ), [Units PY] * ( 1 + [Target Growth] ) )
		formatString: #,0
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 79d31699-955c-4636-b751-a71bde9dc968

	measure 'Target Revenue' = IF ( NOT ISBLANK ( [Revenue PY] ), [Revenue PY] * ( 1 + [Target Growth] ) )
		formatString: $#,0
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 813ed3de-96da-44e8-868c-00adef18f8ac

	measure 'Units vs Target %' = DIVIDE ( [Units Sold], [Target Units] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: da803af6-94c8-4d03-a5de-08000d7a2735

	measure 'Revenue vs Target %' = DIVIDE ( [Revenue], [Target Revenue] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 980ab5b2-1b68-4751-ba8c-4918627e587b

	/// Dùng cho Conditional formatting > Field value
	measure 'Units Target Color' = IF ( ISBLANK ( [Target Units] ), BLANK (), IF ( [Units Sold] >= [Target Units], "#2E7D32", "#C62828" ) )
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: c07d806d-d8f0-4520-83fd-13a994be4cc8

	measure 'Revenue Target Color' = IF ( ISBLANK ( [Target Revenue] ), BLANK (), IF ( [Revenue] >= [Target Revenue], "#2E7D32", "#C62828" ) )
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: c5f75458-a644-4457-9dd3-3f1e7a036338

	measure 'WAPE Color' = IF ( ISBLANK ( [WAPE %] ), BLANK (), IF ( [WAPE %] <= [WAPE Threshold], "#2E7D32", "#C62828" ) )
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 1d9a7d94-0cf3-4794-9b9b-0ae25aa65188

	measure 'Bias Color' = IF ( ISBLANK ( [Bias %] ), BLANK (), IF ( ABS ( [Bias %] ) <= [Bias Threshold], "#2E7D32", "#C62828" ) )
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 95683fc6-e584-4351-b1c6-5ef409bee9c3

	/// Đạt khi WAPE và |Bias| cùng trong ngưỡng
	measure 'Forecast Status' =
			IF (
			    ISBLANK ( [WAPE %] ),
			    BLANK (),
			    IF ( [WAPE %] <= [WAPE Threshold] && ABS ( [Bias %] ) <= [Bias Threshold], "Đạt", "Không đạt" )
			)
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: d1cc97ab-65e8-427c-aa47-7d910bae8c82

	/// Q4 – độ đầy đủ các cột khóa và giá
	measure 'Q4 Completeness %' =
			VAR _rows = COUNTROWS ( fact_car_sales )
			VAR _nulls = COUNTBLANK ( fact_car_sales[date_id] ) + COUNTBLANK ( fact_car_sales[customer_id] )
			    + COUNTBLANK ( fact_car_sales[car_key] ) + COUNTBLANK ( fact_car_sales[dealer_id] )
			    + COUNTBLANK ( fact_car_sales[price] )
			RETURN DIVIDE ( _rows * 5 - _nulls, _rows * 5 )
		formatString: 0.0%
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: 40c6d261-4e13-45bb-a69f-ba6bb1455597

	/// Q5 – tỷ lệ car_id trùng
	measure 'Q5 Duplicate Rate' = DIVIDE ( COUNTROWS ( fact_car_sales ) - DISTINCTCOUNT ( fact_car_sales[car_id] ), COUNTROWS ( fact_car_sales ) )
		formatString: 0.00%
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: d69d87af-6bdb-4be5-97a0-adb56f73485e

	/// Q6 – số ngày từ giao dịch mới nhất đến hôm nay
	measure 'Q6 Data Freshness Days' =
			VAR _lastDay = CALCULATE ( MAX ( fact_car_sales[date_id] ), ALL ( fact_car_sales ) )
			VAR _firstDay = CALCULATE ( MIN ( fact_car_sales[date_id] ), ALL ( fact_car_sales ) )
			VAR _last = DATE ( INT ( _lastDay / 10000 ), MOD ( INT ( _lastDay / 100 ), 100 ), MOD ( _lastDay, 100 ) )
			VAR _first = DATE ( INT ( _firstDay / 10000 ), MOD ( INT ( _firstDay / 100 ), 100 ), MOD ( _firstDay, 100 ) )
			RETURN DATEDIFF ( _last, TODAY (), DAY )
		formatString: #,0
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: 99e71998-e433-439a-bf61-24b1ef1f0c16

	/// Q7 – số tháng có giao dịch
	measure 'Q7 Months with Sales' = COUNTROWS ( FILTER ( ALL ( Calendar[YearMonth] ), [Units Sold] > 0 ) )
		formatString: 0
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: 8253c49d-c41f-40d2-ac31-d0ce60b00a21

	/// Q7 – số tháng từ giao dịch đầu đến cuối
	measure 'Q7 Months in Range' =
			VAR _lastDay = CALCULATE ( MAX ( fact_car_sales[date_id] ), ALL ( fact_car_sales ) )
			VAR _firstDay = CALCULATE ( MIN ( fact_car_sales[date_id] ), ALL ( fact_car_sales ) )
			VAR _last = DATE ( INT ( _lastDay / 10000 ), MOD ( INT ( _lastDay / 100 ), 100 ), MOD ( _lastDay, 100 ) )
			VAR _first = DATE ( INT ( _firstDay / 10000 ), MOD ( INT ( _firstDay / 100 ), 100 ), MOD ( _firstDay, 100 ) )
			RETURN DATEDIFF ( _first, _last, MONTH ) + 1
		formatString: 0
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: bb6e0694-9f90-46ec-a3dd-32fcc16dc180

	/// Q7 – độ phủ chuỗi thời gian (cần ≥ 24 tháng lịch sử)
	measure 'Q7 Coverage %' = DIVIDE ( [Q7 Months with Sales], [Q7 Months in Range] )
		formatString: 0.0%
		displayFolder: 1. Chất lượng dữ liệu
		lineageTag: f2532fb8-ec10-4a71-a8e4-0211550d1099

	/// D8 – số xe trung bình mỗi ngày có bán
	measure 'Units per Selling Day' = DIVIDE ( [Units Sold], CALCULATE ( DISTINCTCOUNT ( fact_car_sales[date_id] ) ) )
		formatString: 0.0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: d9c894e8-d558-4a61-aa96-398b4076250b

	/// D8 – chỉ số ngày trong tuần
	measure 'Weekday Index' =
			DIVIDE (
			    [Units per Selling Day],
			    AVERAGEX ( ALLSELECTED ( Calendar[DayOfWeekNo], Calendar[DayOfWeek] ), [Units per Selling Day] )
			)
		formatString: 0.00
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: ab31fcc7-a2ea-4aea-ae2b-a2b82ae04d47

	/// D13 – xếp hạng mẫu tăng mạnh nhất (lọc ≤ 5 trong visual)
	measure 'Model Gain Rank' = RANKX ( ALLSELECTED ( dim_car[model] ), [Units YoY Delta], , DESC, DENSE )
		formatString: 0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 7aa174c0-1e2a-4ce8-8969-bf91097665e9

	/// D13 – xếp hạng mẫu giảm mạnh nhất (lọc ≤ 5 trong visual)
	measure 'Model Loss Rank' = RANKX ( ALLSELECTED ( dim_car[model] ), [Units YoY Delta], , ASC, DENSE )
		formatString: 0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 4a57674d-d401-4b0d-9507-e4b76a39b2d2

	/// S5 – trọng số tăng trưởng (tổng 4 trọng số = 1)
	measure 'Priority Weight Growth' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Growth[Value], 25), t))
		formatString: 0.00%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 8ca923bf-63c9-484a-af64-90620b418ed1

	measure 'Priority Weight Share' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Share[Value], 25), t))
		formatString: 0.00%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 345553bd-668d-48d8-a44d-8c7fd91bd815

	measure 'Priority Weight Stability' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Stability[Value], 25), t))
		formatString: 0.00%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 8910b192-f60e-448d-b1d6-f74cf7198cfd

	measure 'Priority Weight Accuracy' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Accuracy[Value], 25), t))
		formatString: 0.00%
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: 45e0bff3-1d19-4f44-8b5a-02505c46e106

	measure 'Priority Growth Raw' =
			VAR ym = [DSS Selected Forecast Month]
			VAR predicted = [DSS Forecast Units Company]
			VAR lastYear =
			    CALCULATE(
			        [Units Sold],
			        REMOVEFILTERS(Calendar),
			        Calendar[YearMonth] = ym - 100
			    )
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(predicted)
			        || ISBLANK(ym) || lastYear <= 0,
			    BLANK(),
			    DIVIDE(predicted - lastYear, lastYear)
			)
		formatString: 0.0%
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: bf2631d6-75f8-4a65-8e75-82652a778650

	measure 'Priority Share Raw' =
			VAR units = CALCULATE([Units Sold], REMOVEFILTERS(Calendar))
			VAR totalUnits = CALCULATE(
			    [Units Sold],
			    REMOVEFILTERS(Calendar),
			    ALLSELECTED(dim_car[company])
			)
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(units) || totalUnits <= 0,
			    BLANK(), DIVIDE(units, totalUnits)
			)
		formatString: 0.0%
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 00157a91-1068-42cf-9d4f-c0c4d441788e

	measure 'Priority Stability Raw' =
			VAR cv = [Demand CV Hist]
			RETURN IF(NOT HASONEVALUE(dim_car[company]) || ISBLANK(cv), BLANK(), 1 - cv)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 9a23ba8f-be79-4442-b04a-b85c5471d118

	measure 'Priority Accuracy Raw' =
			VAR co = SELECTEDVALUE(dim_car[company])
			VAR mdl = [DSS Selected Forecast Model]
			VAR bt =
			    CALCULATETABLE(
			        fact_demand_forecast,
			        REMOVEFILTERS(Calendar),
			        REMOVEFILTERS(fact_demand_forecast[month_start]),
			        REMOVEFILTERS(fact_demand_forecast[member]),
			        fact_demand_forecast[is_backtest] = TRUE(),
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[model_name] = mdl,
			        TREATAS({ co }, fact_demand_forecast[member])
			    )
			VAR actual = SUMX(bt, fact_demand_forecast[actual_units])
			VAR absErr = SUMX(
			    bt,
			    ABS(fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units])
			)
			RETURN IF(
			    ISBLANK(co) || ISBLANK(mdl) || actual <= 0,
			    BLANK(), 1 - DIVIDE(absErr, actual)
			)
		formatString: 0.0%
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 8aa7a266-8ed0-4ae9-948a-36b3aa7bfba5

	measure 'Priority Growth Score' =
			VAR v = [Priority Growth Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Growth Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Growth Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: b1718ff1-ddf7-409a-a646-ba67511f07b7

	measure 'Priority Share Score' =
			VAR v = [Priority Share Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Share Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Share Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: f276328a-2769-46b3-b776-818196a11bef

	measure 'Priority Stability Score' =
			VAR v = [Priority Stability Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Stability Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Stability Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: b2031ac1-bd94-4a40-97d4-919ab34dc127

	measure 'Priority Accuracy Score' =
			VAR v = [Priority Accuracy Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Accuracy Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Accuracy Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 78b95cd4-84dd-4850-b55c-b11d3a48a6d9

	measure 'Priority Score' =
			VAR g = [Priority Growth Score]
			VAR s = [Priority Share Score]
			VAR st = [Priority Stability Score]
			VAR a = [Priority Accuracy Score]
			RETURN IF(
			    [Priority Eligible] <> 1 || ISBLANK(g) || ISBLANK(s)
			        || ISBLANK(st) || ISBLANK(a),
			    BLANK(),
			    [Priority Weight Growth] * g
			        + [Priority Weight Share] * s
			        + [Priority Weight Stability] * st
			        + [Priority Weight Accuracy] * a
			)
		formatString: 0.000
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 797d2da8-7e67-4ea2-92b5-5fa143fc11ab

	measure 'Priority Rank' =
			VAR candidates =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			RETURN IF(
			    [Priority Eligible] <> 1, BLANK(),
			    RANKX(candidates, CALCULATE([Priority Score]), , DESC, DENSE)
			)
		formatString: 0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 76b268c9-0552-43f1-bf9e-648a89f595ce

	measure 'DSS Selected Forecast Month' =
			VAR ym = SELECTEDVALUE(Calendar[YearMonth])
			RETURN IF(
			    ISFILTERED(Calendar[YearMonth]) && NOT HASONEVALUE(Calendar[YearMonth]),
			    BLANK(), COALESCE(ym, 202401)
			)
		formatString: 0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 51a4cdf0-754a-46f7-ac16-2b856183b0f4

	measure 'DSS Selected Forecast Model' =
			IF(
			    ISFILTERED(fact_demand_forecast[model_name])
			        && NOT HASONEVALUE(fact_demand_forecast[model_name]),
			    BLANK(),
			    SELECTEDVALUE(fact_demand_forecast[model_name], "sarima")
			)
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: e9771379-e186-4626-aa5e-28961d9c786a

	measure 'DSS Forecast Units Company' =
			VAR ym = [DSS Selected Forecast Month]
			VAR mdl = [DSS Selected Forecast Model]
			VAR co = SELECTEDVALUE(dim_car[company])
			RETURN IF(
			    ISBLANK(co) || ISBLANK(ym) || ISBLANK(mdl), BLANK(),
			    CALCULATE(
			        SUM(fact_demand_forecast[forecast_units]),
			        REMOVEFILTERS(Calendar),
			        Calendar[YearMonth] = ym,
			        REMOVEFILTERS(fact_demand_forecast[member]),
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[is_backtest] = FALSE(),
			        fact_demand_forecast[model_name] = mdl,
			        TREATAS({ co }, fact_demand_forecast[member])
			    )
			)
		formatString: #,0.00
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 36677974-bc60-4f1c-abef-cc2b107085a6

	measure 'Priority Eligible' =
			IF(
			    HASONEVALUE(dim_car[company])
			        && NOT ISBLANK([DSS Selected Forecast Month])
			        && NOT ISBLANK([DSS Selected Forecast Model])
			        && NOT ISBLANK([Priority Growth Raw])
			        && NOT ISBLANK([Priority Share Raw])
			        && NOT ISBLANK([Priority Stability Raw])
			        && NOT ISBLANK([Priority Accuracy Raw]),
			    1, 0
			)
		formatString: 0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 8d995e0a-db7d-4d55-8992-32c74e3ca4a4

	measure 'Priority Weight Total' =
			SELECTEDVALUE(Param_Growth[Value], 25)
			    + SELECTEDVALUE(Param_Share[Value], 25)
			    + SELECTEDVALUE(Param_Stability[Value], 25)
			    + SELECTEDVALUE(Param_Accuracy[Value], 25)
		formatString: 0
		displayFolder: 5. Mục tiêu & ngưỡng
		lineageTag: fd9ed981-6e6b-4f6a-a91e-2fd70b94f73c

	measure 'Priority Score 100' = IF(ISBLANK([Priority Score]), BLANK(), ROUND(100 * [Priority Score], 4))
		formatString: 0.00
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: a5ebb261-f21f-466a-997b-24a621e38725

	measure 'DSS S6 Forecast Units' =
			VAR ym = [DSS Selected Forecast Month]
			VAR mdl = [DSS Selected Forecast Model]
			VAR memberName = SELECTEDVALUE(fact_demand_forecast[member])
			RETURN IF(
			    ISBLANK(ym) || ISBLANK(mdl) || ISBLANK(memberName), BLANK(),
			    CALCULATE(
			        SUM(fact_demand_forecast[forecast_units]),
			        REMOVEFILTERS(Calendar),
			        Calendar[YearMonth] = ym,
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[is_backtest] = FALSE(),
			        fact_demand_forecast[model_name] = mdl
			    )
			)
		formatString: #,0.00
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 8357392b-9a57-46ed-895b-02a4c28e982d

	measure 'DSS S6 Eligible' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF(
			    HASONEVALUE(fact_demand_forecast[member])
			        && NOT ISBLANK(f) && f >= 0
			        && NOT ISBLANK(cv) && cv >= 0
			        && NOT ISBLANK(asp) && asp > 0,
			    1, 0
			)
		formatString: 0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 88142e26-abe3-436b-9cb3-8c2dcc787a4c

	measure 'DSS Order Baseline' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), MAX(0, ROUNDUP(f * (1 + cv), 0)))
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: f2da4cc0-6cc1-4914-9092-ed07e5444bbc

	measure 'DSS Order Scenario' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), MAX(0, ROUNDUP(f * (1 + d) * (1 + k * cv), 0)))
		formatString: #,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 1f079b3c-330a-4607-9e99-74de782cd805

	measure 'DSS Order Delta' = IF([DSS S6 Eligible] <> 1, BLANK(), [DSS Order Scenario] - [DSS Order Baseline])
		formatString: +#,0;-#,0;0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 33cecb65-0710-46c6-9b8d-cf2fa75c8aff

	measure 'DSS Revenue Baseline' =
			VAR f = [DSS S6 Forecast Units]
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), f * asp)
		formatString: $#,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: d14495d2-efbb-4622-a2dc-efc889e96186

	measure 'DSS Revenue Scenario' =
			VAR f = [DSS S6 Forecast Units]
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), f * (1 + [Demand Change Value]) * asp)
		formatString: $#,0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: 0f3894e9-db34-4d7a-b0a3-787f27b92ebc

	measure 'DSS Revenue Delta' = IF([DSS S6 Eligible] <> 1, BLANK(), [DSS Revenue Scenario] - [DSS Revenue Baseline])
		formatString: +$#,0;-$#,0;$0
		displayFolder: 4. Hỗ trợ quyết định
		lineageTag: d09e7a92-8c4d-4593-a57d-217e7dff5cd1

	column Value
		dataType: int64
		isHidden
		lineageTag: 643458fc-4681-4d17-9b80-f1352cb991f5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", 0 )

