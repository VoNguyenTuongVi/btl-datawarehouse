table _Measures
	lineageTag: 355ed847-9ceb-4583-90cb-aa75461dfcb4

	/// D1 – Sản lượng bán
	measure 'Units' = SUM ( kpi_monthly_overview[units] )
		formatString: #,0
		displayFolder: 1. Tổng quan
		lineageTag: c89ab25a-501f-4f65-891b-0d7e4be3b06a

	/// D2 – Doanh thu
	measure 'Revenue' = SUM ( kpi_monthly_overview[revenue] )
		formatString: $#,0
		displayFolder: 1. Tổng quan
		lineageTag: 65a40d27-2efe-4213-ab79-70054bed4324

	/// D3 – Giá bán bình quân
	measure 'ASP' = DIVIDE ( [Revenue], [Units] )
		formatString: $#,0
		displayFolder: 1. Tổng quan
		lineageTag: 6328b204-51f7-4119-b1b2-c16961f335ca

	/// Sản lượng cùng kỳ năm trước
	measure 'Units PY' = SUM ( kpi_monthly_overview[units_py] )
		formatString: #,0
		displayFolder: 1. Tổng quan
		lineageTag: a0bd2376-a548-46b1-bfc2-e0f3eb42d993

	measure 'Revenue PY' = SUM ( kpi_monthly_overview[revenue_py] )
		formatString: $#,0
		displayFolder: 1. Tổng quan
		lineageTag: fb27ac6d-991a-4632-a8de-4106413c85af

	/// D4 – so cùng kỳ
	measure 'Units YoY %' =
			VAR _t = FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[units_py] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_overview[units] )
			VAR _base = SUMX ( _t, kpi_monthly_overview[units_py] )
			RETURN DIVIDE ( _cur - _base, _base )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: 5728ac15-45de-4853-b465-c59b08f6db99

	/// D4 – so cùng kỳ
	measure 'Revenue YoY %' =
			VAR _t = FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[revenue_py] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_overview[revenue] )
			VAR _base = SUMX ( _t, kpi_monthly_overview[revenue_py] )
			RETURN DIVIDE ( _cur - _base, _base )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: a92e16e1-86c4-47af-816c-48259fc18208

	/// D4 – so tháng trước
	measure 'Units MoM %' =
			VAR _t = FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[units_pm] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_overview[units] )
			VAR _base = SUMX ( _t, kpi_monthly_overview[units_pm] )
			RETURN DIVIDE ( _cur - _base, _base )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: f49f2958-215c-47e4-81ba-e41aa36a7991

	/// D4
	measure 'Revenue MoM %' =
			VAR _t = FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[revenue_pm] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_overview[revenue] )
			VAR _base = SUMX ( _t, kpi_monthly_overview[revenue_pm] )
			RETURN DIVIDE ( _cur - _base, _base )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: efe3e918-23fe-4ab7-a619-070ca6968474

	/// D4 – lũy kế đến tháng cuối đang chọn
	measure 'Units YTD' =
			VAR _m = MAX ( kpi_monthly_overview[month_start] )
			RETURN CALCULATE ( SUM ( kpi_monthly_overview[units_ytd] ), kpi_monthly_overview[month_start] = _m )
		formatString: #,0
		displayFolder: 1. Tổng quan
		lineageTag: 7fa1c53f-60e0-476a-ae36-e48768ca5a64

	measure 'Revenue YTD' =
			VAR _m = MAX ( kpi_monthly_overview[month_start] )
			RETURN CALCULATE ( SUM ( kpi_monthly_overview[revenue_ytd] ), kpi_monthly_overview[month_start] = _m )
		formatString: $#,0
		displayFolder: 1. Tổng quan
		lineageTag: efd335d3-f316-4e39-8000-fa933b3e79ba

	/// D4
	measure 'Units YTD YoY %' =
			VAR _m = MAX ( kpi_monthly_overview[month_start] )
			VAR _c = CALCULATE ( SUM ( kpi_monthly_overview[units_ytd] ), kpi_monthly_overview[month_start] = _m )
			VAR _p = CALCULATE ( SUM ( kpi_monthly_overview[units_ytd_py] ), kpi_monthly_overview[month_start] = _m )
			RETURN DIVIDE ( _c - _p, _p )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: 8f9be064-a71e-464f-a300-1922f05be8c1

	/// D4
	measure 'Revenue YTD YoY %' =
			VAR _m = MAX ( kpi_monthly_overview[month_start] )
			VAR _c = CALCULATE ( SUM ( kpi_monthly_overview[revenue_ytd] ), kpi_monthly_overview[month_start] = _m )
			VAR _p = CALCULATE ( SUM ( kpi_monthly_overview[revenue_ytd_py] ), kpi_monthly_overview[month_start] = _m )
			RETURN DIVIDE ( _c - _p, _p )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: ff03da35-5e23-458c-8b40-6226dd08112b

	/// D7 – 1,0 = tháng trung bình; trung bình 2 năm
	measure 'Seasonality Index' = AVERAGE ( kpi_monthly_overview[seasonality_index_2y] )
		formatString: 0.000
		displayFolder: 1. Tổng quan
		lineageTag: fddb732b-b98a-43b6-9591-6214847992d9

	/// D14
	measure 'Auto Share %' = DIVIDE ( SUM ( kpi_monthly_overview[auto_units] ), [Units] )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: 22157001-8152-4c19-9746-4482a40f6481

	/// D16 – % đại lý tăng so cùng kỳ
	measure 'Dealers Growing %' = DIVIDE ( SUM ( kpi_monthly_overview[dealers_growing] ), SUM ( kpi_monthly_overview[dealers_compared] ) )
		formatString: 0.0%
		displayFolder: 1. Tổng quan
		lineageTag: 6f0184e8-e8cc-4585-b86a-fa8ce73ea6d9

	/// D16 – xe/đại lý/tháng
