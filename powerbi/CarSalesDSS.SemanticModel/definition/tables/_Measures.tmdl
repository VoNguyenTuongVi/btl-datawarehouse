	/// D12–D17
	measure 'Dim Units YoY %' =
			VAR _t = FILTER ( kpi_monthly_by_dimension, NOT ISBLANK ( kpi_monthly_by_dimension[units_py] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_by_dimension[units] )
