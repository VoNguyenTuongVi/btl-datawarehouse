table _Measures
	lineageTag: 2f0a221d-e237-4253-8089-60f075ff5531

	/// D1 – Sản lượng bán
	measure 'Units Sold' = SUM ( fact_car_sales[quantity] )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: a3d5204d-28cd-40c2-8f1d-41d31a731d0e

	/// D2 – Doanh thu
	measure 'Revenue' = SUM ( fact_car_sales[price] )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: a6c775cd-5d9f-4507-ac70-1a1301d417a1

	/// D3 – Giá bán bình quân
	measure 'ASP' = DIVIDE ( [Revenue], [Units Sold] )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 265d3f67-e6eb-49e3-b1f5-4a112729afd5

	measure 'Units PM' = CALCULATE ( [Units Sold], DATEADD ( Calendar[Date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 86c943ce-db45-493b-96c2-23a1a2b33f71

	measure 'Units PQ' = CALCULATE ( [Units Sold], DATEADD ( Calendar[Date], -1, QUARTER ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 2d438e0f-044f-4ce5-9e9b-b817a50eeddd

	measure 'Units PY' = CALCULATE ( [Units Sold], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		formatString: #,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: a64010fc-add8-4e1b-8d4a-7f8027c85801

	measure 'Revenue PM' = CALCULATE ( [Revenue], DATEADD ( Calendar[Date], -1, MONTH ) )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 7643d009-94fc-4b0d-a15d-457b9cb180a4

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
		formatString: $#,0
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: b7696c7f-8a19-4ca1-bf0e-880da6bc4ba7

	/// D4
	measure 'Units MoM %' = DIVIDE ( [Units Sold] - [Units PM], [Units PM] )
		formatString: 0.0%
		displayFolder: 2. Nhu cầu lịch sử
		lineageTag: 2057be23-52e5-4884-8360-a7916d070e32

	/// D4
	measure 'Units QoQ %' = DIVIDE ( [Units Sold] - [Units PQ], [Units PQ] )
