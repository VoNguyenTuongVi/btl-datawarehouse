	/// F7 – dương là tốt hơn seasonal naive
	measure 'FVA' = IF ( NOT ISBLANK ( [WAPE %] ), [Naive WAPE %] - [WAPE %] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4. Dự báo
		lineageTag: a62e4866-9806-4db3-93e8-93b9b36335d6

	/// F1 6 tháng tới, mô hình chính
	measure 'Plan Forecast Units' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    SUM ( dss_forecast_plan[forecast_units] ),
			    CALCULATE ( SUM ( dss_forecast_plan[forecast_units] ), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 804201c4-f101-4252-ae5b-4577b41ceebc

	measure 'Plan Units PY' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    SUM ( dss_forecast_plan[units_py] ),
			    CALCULATE ( SUM ( dss_forecast_plan[units_py] ), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 5d4b4938-591c-47ed-8d1a-9f044fd04920

	/// S1
	measure 'Forecast Growth %' = DIVIDE ( [Plan Forecast Units] - [Plan Units PY], [Plan Units PY] )
		formatString: 0.0%
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: df0a6f21-0b3d-4172-a222-d9710f9fd2a5

	/// S3, S6 – theo thanh trượt What-if
	measure 'Recommended Order' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    SUMX ( dss_forecast_plan, dss_forecast_plan[forecast_units] * ( 1 + [Demand Change Value] ) * ( 1 + [Safety Factor Value] * dss_forecast_plan[demand_cv] ) ),
			    CALCULATE ( SUMX ( dss_forecast_plan, dss_forecast_plan[forecast_units] * ( 1 + [Demand Change Value] ) * ( 1 + [Safety Factor Value] * dss_forecast_plan[demand_cv] ) ), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 89adf1f3-9c18-4d23-ac98-b7c3f103994a

	/// S4, S6
	measure 'Projected Revenue' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    SUMX ( dss_forecast_plan, dss_forecast_plan[forecast_units] * ( 1 + [Demand Change Value] ) * dss_forecast_plan[asp_hist] ),
			    CALCULATE ( SUMX ( dss_forecast_plan, dss_forecast_plan[forecast_units] * ( 1 + [Demand Change Value] ) * dss_forecast_plan[asp_hist] ), dim_forecast_member[level] = "total" )
			)
		formatString: $#,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: b5aebb90-e257-404b-9453-f1195007db3b

	/// S2
	measure 'Allocated Units' = SUM ( dss_dealer_allocation[allocated_units] ) * ( 1 + [Demand Change Value] )
		formatString: #,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 24969457-bac8-4dda-8600-0a2f06eeab23

	/// S2
	measure 'Allocated Revenue' = SUM ( dss_dealer_allocation[allocated_revenue] ) * ( 1 + [Demand Change Value] )
		formatString: $#,0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 710e8370-6fc6-4bea-be41-eca938abece0

	/// S5
	measure 'Priority Score' = AVERAGE ( dss_company_priority[priority_score] )
		formatString: 0.000
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 0ad5e8bd-904a-46f5-8b30-842f47afba70

	/// S5
	measure 'Priority Rank' = MIN ( dss_company_priority[priority_rank] )
		formatString: 0
		displayFolder: 5. Hỗ trợ quyết định
		lineageTag: 19505b38-bd28-4f44-ae30-85c1417d8082

	measure 'Target Growth' = MAX ( kpi_parameters[target_growth] )
		formatString: 0.0%
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: c0dc970a-0641-428a-bb8c-0069106d8e56

	measure 'WAPE Threshold' = MAX ( kpi_parameters[wape_threshold] )
		formatString: 0.0%
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: b6226d5e-0027-4dd7-8856-25d5294f9759

	measure 'Bias Threshold' = MAX ( kpi_parameters[bias_threshold] )
		formatString: 0.0%
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: a8d04a95-206b-41c1-800e-7fea1222e216

	measure 'Target Units' = SUMX ( FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[target_units] ) ), kpi_monthly_overview[target_units] )
		formatString: #,0
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: dbe7922c-eb55-45ed-b16a-fd59e72aaff1

	measure 'Target Revenue' = SUMX ( FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[target_revenue] ) ), kpi_monthly_overview[target_revenue] )
		formatString: $#,0
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 6e5b7ed2-ee41-4cc6-a858-4284d24774ef

	measure 'Units vs Target %' =
			VAR _a = SUMX ( FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[target_units] ) ), kpi_monthly_overview[units] )
			RETURN DIVIDE ( _a, [Target Units] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 2a74c1b4-abe7-4f08-a316-99b91818e8dd

	measure 'Revenue vs Target %' =
			VAR _a = SUMX ( FILTER ( kpi_monthly_overview, NOT ISBLANK ( kpi_monthly_overview[target_revenue] ) ), kpi_monthly_overview[revenue] )
			RETURN DIVIDE ( _a, [Target Revenue] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 54665c23-0df8-419f-a795-5f21e5afa3a1

	/// Conditional formatting > Field value
	measure 'Units Target Color' = IF ( ISBLANK ( [Units vs Target %] ), BLANK (), IF ( [Units vs Target %] >= 0, "#2E7D32", "#C62828" ) )
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 4a456f85-e0fe-46b8-90c1-73a7fa37cf72

	measure 'Revenue Target Color' = IF ( ISBLANK ( [Revenue vs Target %] ), BLANK (), IF ( [Revenue vs Target %] >= 0, "#2E7D32", "#C62828" ) )
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 082bf763-30ab-4cea-aa65-48dec04002fc

	measure 'WAPE Color' = IF ( ISBLANK ( [WAPE %] ), BLANK (), IF ( [WAPE %] <= [WAPE Threshold], "#2E7D32", "#C62828" ) )
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: e5e3b9ec-f69e-4d85-84b9-1f6a9bcad001

	measure 'Bias Color' = IF ( ISBLANK ( [Bias %] ), BLANK (), IF ( ABS ( [Bias %] ) <= [Bias Threshold], "#2E7D32", "#C62828" ) )
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 52e529a9-d3eb-4c3c-8008-7814ed22973d

	/// Đạt khi WAPE và |Bias| cùng trong ngưỡng
	measure 'Forecast Status' =
			IF (
			    ISBLANK ( [WAPE %] ),
			    BLANK (),
			    IF ( [WAPE %] <= [WAPE Threshold] && ABS ( [Bias %] ) <= [Bias Threshold], "Đạt", "Không đạt" )
			)
		displayFolder: 6. Mục tiêu & ngưỡng
		lineageTag: 2091cbe3-d278-4ea5-bbd1-1dcfce717d7c

	measure 'DQ Checks Passed' = COUNTROWS ( FILTER ( dq_checks, dq_checks[passed] = TRUE () ) )
		formatString: 0
		displayFolder: 7. Chất lượng dữ liệu
		lineageTag: 1637d6a1-1497-4081-ab7b-98241d084ff7

	/// Q1–Q6
	measure 'DQ Pass Rate' = DIVIDE ( [DQ Checks Passed], COUNTROWS ( dq_checks ) )
		formatString: 0.0%
		displayFolder: 7. Chất lượng dữ liệu
		lineageTag: b65b6a37-1995-4583-8a75-3b2023a11bf4

	column 'Value'
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]
		lineageTag: 831755eb-5f18-4380-b4db-aae2934df42c

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", 0 )
