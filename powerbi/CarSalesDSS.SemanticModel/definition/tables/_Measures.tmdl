	/// D8 – 1,0 = ngày trung bình
	measure 'Weekday Index' =
			DIVIDE (
			    DIVIDE ( SUM ( kpi_weekday[units] ), SUM ( kpi_weekday[selling_days] ) ),
			    CALCULATE ( DIVIDE ( SUM ( kpi_weekday[units] ), SUM ( kpi_weekday[selling_days] ) ),
			                ALLSELECTED ( kpi_weekday[day_of_week], kpi_weekday[dow_no] ) )
			)
		formatString: 0.000
		displayFolder: 3. Khách hàng & ngày
		lineageTag: 7ffa8d44-3a1a-4c0a-bdaf-c435cabd8633

	/// Thực tế trên trục dự báo (mặc định cấp tổng)
	measure 'Actual Units' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    DIVIDE ( SUM ( forecast_series[actual_units] ), DISTINCTCOUNT ( forecast_series[model_name] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_series[actual_units] ), DISTINCTCOUNT ( forecast_series[model_name] ) ), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 4. Dự báo
		lineageTag: e9e5377c-a59f-4101-9dab-cbdf93c8c4a3

	/// F1 – mặc định mô hình chính, cấp tổng
	measure 'Forecast Units' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[forecast_units] ),
			    CALCULATE ( SUM ( forecast_series[forecast_units] ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[forecast_units] ),
			    CALCULATE ( SUM ( forecast_series[forecast_units] ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 4. Dự báo
		lineageTag: c6d0a9da-ccec-4683-8ff9-049e47dead24

	measure 'Forecast Lower 80' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[lower_80] ),
			    CALCULATE ( SUM ( forecast_series[lower_80] ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[lower_80] ),
			    CALCULATE ( SUM ( forecast_series[lower_80] ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 4. Dự báo
		lineageTag: 2a9e97d6-986c-421c-9384-b0ecb23a1a57

	measure 'Forecast Upper 80' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[upper_80] ),
			    CALCULATE ( SUM ( forecast_series[upper_80] ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    SUM ( forecast_series[upper_80] ),
			    CALCULATE ( SUM ( forecast_series[upper_80] ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "total" )
			)
		formatString: #,0
		displayFolder: 4. Dự báo
		lineageTag: 7ee4684b-980a-48b6-89d2-9f6516e7539d

	/// F3 – mặc định cấp hãng, mô hình chính
	measure 'WAPE %' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[actual_total] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[actual_total] ) ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[actual_total] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[actual_total] ) ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "company" )
			)
		formatString: 0.0%
		displayFolder: 4. Dự báo
		lineageTag: 2548129a-7450-4cb1-a7f6-5e1d2a2d1af5

	/// F3
	measure 'Forecast Accuracy %' = IF ( NOT ISBLANK ( [WAPE %] ), 1 - [WAPE %] )
		formatString: 0.0%
		displayFolder: 4. Dự báo
		lineageTag: f630f835-355b-4a6e-b183-9d16cc3ae429

	/// F5 – dương là dự báo dư
	measure 'Bias %' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[error_total] ), SUM ( forecast_accuracy[actual_total] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[error_total] ), SUM ( forecast_accuracy[actual_total] ) ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[error_total] ), SUM ( forecast_accuracy[actual_total] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[error_total] ), SUM ( forecast_accuracy[actual_total] ) ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "company" )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4. Dự báo
		lineageTag: 98ba560d-029c-42df-b594-b876a0fa1064

	/// F4
	measure 'MAE' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[n_points] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[n_points] ) ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[n_points] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[abs_error_total] ), SUM ( forecast_accuracy[n_points] ) ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "company" )
			)
		formatString: #,0.0
		displayFolder: 4. Dự báo
		lineageTag: 790e2584-131e-48aa-87a1-fbc66a8f29d4

	/// F8 – mục tiêu ≈ 80%
	measure 'Interval Coverage %' =
			IF (
			    ISFILTERED ( dim_forecast_member[level] ) || ISFILTERED ( dim_forecast_member[level_label] )
			        || ISFILTERED ( dim_forecast_member[member] ),
			    IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[n_in_interval] ), SUM ( forecast_accuracy[n_points] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[n_in_interval] ), SUM ( forecast_accuracy[n_points] ) ), dim_forecast_model[is_main_model] = TRUE () )
			),
			    CALCULATE ( IF (
			    ISFILTERED ( dim_forecast_model[model_name] ) || ISFILTERED ( dim_forecast_model[model_label] ),
			    DIVIDE ( SUM ( forecast_accuracy[n_in_interval] ), SUM ( forecast_accuracy[n_points] ) ),
			    CALCULATE ( DIVIDE ( SUM ( forecast_accuracy[n_in_interval] ), SUM ( forecast_accuracy[n_points] ) ), dim_forecast_model[is_main_model] = TRUE () )
			), dim_forecast_member[level] = "company" )
			)
		formatString: 0.0%
		displayFolder: 4. Dự báo
		lineageTag: 5a66f062-bdab-4fc7-9ecb-374ae8bcadec

	measure 'Naive WAPE %' = CALCULATE ( [WAPE %], dim_forecast_model[model_name] = "seasonal_naive" )
		formatString: 0.0%
		displayFolder: 4. Dự báo
