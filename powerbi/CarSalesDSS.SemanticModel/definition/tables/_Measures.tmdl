		lineageTag: f3db0470-b7fa-4eba-bac0-c664fa4bee99

	/// S5/S6 – mặc định 202401; chọn đúng một tháng nếu dùng slicer
	measure 'DSS Selected Forecast Month' =
			VAR ym = SELECTEDVALUE(dim_month[year_month])
			RETURN IF(
			    ISFILTERED(dim_month[year_month]) && NOT HASONEVALUE(dim_month[year_month]),
			    BLANK(), COALESCE(ym, 202401)
			)
		formatString: 0
		displayFolder: 8. DSS S5/S6
		lineageTag: 2226ea24-6f7f-49a5-b470-aacd5060fc0a

	/// S5/S6 – mặc định sarima; chỉ chọn một mô hình
	measure 'DSS Selected Forecast Model' =
			IF(
			    ISFILTERED(fact_demand_forecast[model_name])
			        && NOT HASONEVALUE(fact_demand_forecast[model_name]),
			    BLANK(),
			    SELECTEDVALUE(fact_demand_forecast[model_name], "sarima")
			)
		displayFolder: 8. DSS S5/S6
		lineageTag: 9cbbe294-c74d-4847-85de-a3fec432f513

	/// S5 – dự báo một tháng theo đúng hãng, mô hình và kỳ
	measure 'DSS Forecast Units Company' =
			VAR ym = [DSS Selected Forecast Month]
			VAR mdl = [DSS Selected Forecast Model]
			VAR co = SELECTEDVALUE(dim_car[company])
			RETURN IF(
			    ISBLANK(co) || ISBLANK(ym) || ISBLANK(mdl), BLANK(),
			    CALCULATE(
			        SUM(fact_demand_forecast[forecast_units]),
			        REMOVEFILTERS(dim_month),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_calendar),
			        REMOVEFILTERS(dim_year),
			        dim_month[year_month] = ym,
			        REMOVEFILTERS(fact_demand_forecast[member]),
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[is_backtest] = FALSE(),
			        fact_demand_forecast[model_name] = mdl,
			        TREATAS({ co }, fact_demand_forecast[member])
			    )
			)
		formatString: #,0.00
		displayFolder: 8. DSS S5/S6
		lineageTag: 2d38a9b9-8a65-4317-a786-dfa67a81e60f

	/// S5 – forecast tháng t / actual cùng hãng tháng t-12 trừ 1
	measure 'Priority Growth Raw' =
			VAR ym = [DSS Selected Forecast Month]
			VAR predicted = [DSS Forecast Units Company]
			VAR lastYear =
			    CALCULATE(
			        [Fact Units],
			        REMOVEFILTERS(dim_month),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_calendar),
			        REMOVEFILTERS(dim_year),
			        dim_month[year_month] = ym - 100
			    )
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(predicted)
			        || ISBLANK(ym) || lastYear <= 0,
			    BLANK(),
			    DIVIDE(predicted - lastYear, lastYear)
			)
		formatString: 0.0%
		displayFolder: 8. DSS S5/S6
		lineageTag: 8a68ed9d-973a-4f4d-821e-2acc68120c17

	/// S5 – thị phần sản lượng lịch sử của hãng trên tập hãng được chọn
	measure 'Priority Share Raw' =
			VAR units = CALCULATE([Fact Units], REMOVEFILTERS(dim_month), REMOVEFILTERS(dim_date), REMOVEFILTERS(dim_calendar), REMOVEFILTERS(dim_year))
			VAR totalUnits = CALCULATE(
			    [Fact Units],
			    REMOVEFILTERS(dim_month),
			    REMOVEFILTERS(dim_date),
			    REMOVEFILTERS(dim_calendar),
			    REMOVEFILTERS(dim_year),
			    ALLSELECTED(dim_car[company])
			)
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(units) || totalUnits <= 0,
			    BLANK(), DIVIDE(units, totalUnits)
			)
		formatString: 0.0%
		displayFolder: 8. DSS S5/S6
		lineageTag: 5ad14098-15a8-42ff-b1c6-d5ee90942790

	/// S5 – 1−CV; không coi CV thiếu bằng 0
	measure 'Priority Stability Raw' =
			VAR cv = [Demand CV Hist]
			RETURN IF(NOT HASONEVALUE(dim_car[company]) || ISBLANK(cv), BLANK(), 1 - cv)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: 26028471-c49d-455e-a52b-abc099945a8d

	/// S5 – 1−WAPE cấp hãng, cùng mô hình, toàn bộ backtest lịch sử
	measure 'Priority Accuracy Raw' =
			VAR co = SELECTEDVALUE(dim_car[company])
			VAR mdl = [DSS Selected Forecast Model]
			VAR bt =
			    CALCULATETABLE(
			        fact_demand_forecast,
			        REMOVEFILTERS(dim_month),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_calendar),
			        REMOVEFILTERS(dim_year),
			        REMOVEFILTERS(fact_demand_forecast[month_start]),
			        REMOVEFILTERS(fact_demand_forecast[member]),
			        fact_demand_forecast[is_backtest] = TRUE(),
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[model_name] = mdl,
			        TREATAS({ co }, fact_demand_forecast[member])
			    )
			VAR actual = SUMX(bt, fact_demand_forecast[actual_units])
			VAR absErr = SUMX(
			    bt,
			    ABS(fact_demand_forecast[actual_units] - fact_demand_forecast[forecast_units])
			)
			RETURN IF(
			    ISBLANK(co) || ISBLANK(mdl) || actual <= 0,
			    BLANK(), 1 - DIVIDE(absErr, actual)
			)
		formatString: 0.0%
		displayFolder: 8. DSS S5/S6
		lineageTag: f641cf2d-7f64-49d4-a014-d1081eb5caad

	/// S5 – chỉ hãng có đủ 4 tiêu chí mới được xếp hạng
	measure 'Priority Eligible' =
			IF(
			    HASONEVALUE(dim_car[company])
			        && NOT ISBLANK([DSS Selected Forecast Month])
			        && NOT ISBLANK([DSS Selected Forecast Model])
			        && NOT ISBLANK([Priority Growth Raw])
			        && NOT ISBLANK([Priority Share Raw])
			        && NOT ISBLANK([Priority Stability Raw])
			        && NOT ISBLANK([Priority Accuracy Raw]),
			    1, 0
			)
		formatString: 0
		displayFolder: 8. DSS S5/S6
		lineageTag: f32f4dcb-dabb-44c3-a591-82f8c72450cb

	/// S5 – tổng 4 mức ưu tiên trên slicer, không bắt buộc bằng 100
	measure 'Priority Weight Total' =
			SELECTEDVALUE(Param_Growth[Value], 25)
			    + SELECTEDVALUE(Param_Share[Value], 25)
			    + SELECTEDVALUE(Param_Stability[Value], 25)
			    + SELECTEDVALUE(Param_Accuracy[Value], 25)
		formatString: 0
		displayFolder: 8. DSS S5/S6
		lineageTag: 2f1f9651-2323-49fc-831a-2c1f49a88ef3

	/// S5 – trọng số Growth đã chuẩn hóa, 4 trọng số cộng bằng 1
	measure 'Priority Weight Growth' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Growth[Value], 25), t))
		formatString: 0.00%
		displayFolder: 8. DSS S5/S6
		lineageTag: 8882af70-57bc-4a7b-a583-6844b32890b7

	/// S5 – trọng số Share đã chuẩn hóa, 4 trọng số cộng bằng 1
	measure 'Priority Weight Share' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Share[Value], 25), t))
		formatString: 0.00%
		displayFolder: 8. DSS S5/S6
		lineageTag: 05da9cb1-962c-486e-8648-25accb0337c5

	/// S5 – trọng số Stability đã chuẩn hóa, 4 trọng số cộng bằng 1
	measure 'Priority Weight Stability' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Stability[Value], 25), t))
		formatString: 0.00%
		displayFolder: 8. DSS S5/S6
		lineageTag: fa3f50e7-fada-4dc6-8a41-ff45f71c884f

	/// S5 – trọng số Accuracy đã chuẩn hóa, 4 trọng số cộng bằng 1
	measure 'Priority Weight Accuracy' =
			VAR t = [Priority Weight Total]
			RETURN IF(t = 0, 0.25, DIVIDE(SELECTEDVALUE(Param_Accuracy[Value], 25), t))
		formatString: 0.00%
		displayFolder: 8. DSS S5/S6
		lineageTag: 50bc0a11-0c94-4e90-aec9-937bbf0d5530

	/// S5 – min-max cùng tập hãng hợp lệ; bằng nhau dùng điểm 0.5
	measure 'Priority Growth Score' =
			VAR v = [Priority Growth Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Growth Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Growth Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: d35a0289-63e8-4113-9e20-25339836b323

	/// S5 – min-max cùng tập hãng hợp lệ; bằng nhau dùng điểm 0.5
	measure 'Priority Share Score' =
			VAR v = [Priority Share Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Share Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Share Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: 529baf1e-7170-4076-b5d0-256d67adc681

	/// S5 – min-max cùng tập hãng hợp lệ; bằng nhau dùng điểm 0.5
	measure 'Priority Stability Score' =
			VAR v = [Priority Stability Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Stability Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Stability Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: d66409de-e3e9-40fe-bb02-2a91e14d8715

	/// S5 – min-max cùng tập hãng hợp lệ; bằng nhau dùng điểm 0.5
	measure 'Priority Accuracy Score' =
			VAR v = [Priority Accuracy Raw]
			VAR eligibleCompanies =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			VAR lo = MINX(eligibleCompanies, CALCULATE([Priority Accuracy Raw]))
			VAR hi = MAXX(eligibleCompanies, CALCULATE([Priority Accuracy Raw]))
			RETURN IF(
			    [Priority Eligible] <> 1 || ISEMPTY(eligibleCompanies), BLANK(),
			    IF(hi = lo, 0.5, DIVIDE(v - lo, hi - lo))
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: a12b7c41-6044-4a61-b012-338f19d8095a

	/// S5 – weighted scoring, thang 0..1; không tính thiếu KPI
	measure 'Priority Score' =
			VAR g = [Priority Growth Score]
			VAR s = [Priority Share Score]
			VAR st = [Priority Stability Score]
			VAR a = [Priority Accuracy Score]
			RETURN IF(
			    [Priority Eligible] <> 1 || ISBLANK(g) || ISBLANK(s)
			        || ISBLANK(st) || ISBLANK(a),
			    BLANK(),
			    [Priority Weight Growth] * g
			        + [Priority Weight Share] * s
			        + [Priority Weight Stability] * st
			        + [Priority Weight Accuracy] * a
			)
		formatString: 0.000
		displayFolder: 8. DSS S5/S6
		lineageTag: 3dfb143c-3e0b-49a7-860e-adb2d5d20e44

	/// S5 – điểm hiển thị 0..100, không làm đổi thứ hạng
	measure 'Priority Score 100' = IF(ISBLANK([Priority Score]), BLANK(), ROUND(100 * [Priority Score], 4))
		formatString: 0.00
		displayFolder: 8. DSS S5/S6
		lineageTag: 46c5766e-77bf-40b5-ab71-663c16655316

	/// S5 – xếp hạng giảm dần theo điểm trên cùng tập hãng hợp lệ
	measure 'Priority Rank' =
			VAR candidates =
			    FILTER(
			        ALLSELECTED(dim_car[company]),
			        CALCULATE([Priority Eligible]) = 1
			    )
			RETURN IF(
			    [Priority Eligible] <> 1, BLANK(),
			    RANKX(candidates, CALCULATE([Priority Score]), , DESC, DENSE)
			)
		formatString: 0
		displayFolder: 8. DSS S5/S6
		lineageTag: 03855e8b-8f17-4ada-83e7-c8fd35727a21

	/// S6 – dự báo tháng/mô hình được chọn theo member của cấp company
	measure 'DSS S6 Forecast Units' =
			VAR ym = [DSS Selected Forecast Month]
			VAR mdl = [DSS Selected Forecast Model]
			VAR memberName = SELECTEDVALUE(fact_demand_forecast[member])
			RETURN IF(
			    ISBLANK(ym) || ISBLANK(mdl) || ISBLANK(memberName), BLANK(),
			    CALCULATE(
			        SUM(fact_demand_forecast[forecast_units]),
			        REMOVEFILTERS(dim_month),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_calendar),
			        REMOVEFILTERS(dim_year),
			        dim_month[year_month] = ym,
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[is_backtest] = FALSE(),
			        fact_demand_forecast[model_name] = mdl
			    )
			)
		formatString: #,0.00
		displayFolder: 8. DSS S5/S6
		lineageTag: 52df6797-b07b-4ea2-bdf0-4f4ba3888c99

	/// S6 – chỉ member cấp company có forecast/CV/ASP hợp lệ
	measure 'DSS S6 Eligible' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF(
			    HASONEVALUE(fact_demand_forecast[member])
			        && NOT ISBLANK(f) && f >= 0
			        && NOT ISBLANK(cv) && cv >= 0
			        && NOT ISBLANK(asp) && asp > 0,
			    1, 0
			)
		formatString: 0
		displayFolder: 8. DSS S5/S6
		lineageTag: 6855bf8f-23f2-47ea-abd3-00dca165894b

	/// S6 – số xe nhập cơ sở: Demand Change 0%, Safety Factor 1
	measure 'DSS Order Baseline' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), MAX(0, ROUNDUP(f * (1 + cv), 0)))
		formatString: #,0
		displayFolder: 8. DSS S5/S6
		lineageTag: b04ee293-ce8f-459e-b165-b62c7a2aa894

	/// S6 – số xe nhập theo thay đổi nhu cầu và hệ số dự phòng
	measure 'DSS Order Scenario' =
			VAR f = [DSS S6 Forecast Units]
			VAR cv = CALCULATE([Demand CV for Member], fact_demand_forecast[level] = "company")
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), MAX(0, ROUNDUP(f * (1 + d) * (1 + k * cv), 0)))
		formatString: #,0
		displayFolder: 8. DSS S5/S6
		lineageTag: 531e5a9e-1ed7-4e9b-ba01-50dc25035da7

	/// S6 – chênh lệch số xe nhập Scenario – Baseline
	measure 'DSS Order Delta' = IF([DSS S6 Eligible] <> 1, BLANK(), [DSS Order Scenario] - [DSS Order Baseline])
		formatString: +#,0;-#,0;0
		displayFolder: 8. DSS S5/S6
		lineageTag: 9530c00d-fbfa-4c60-8bff-f5ace6797c79

	/// S6 – doanh thu dự kiến cơ sở: sản lượng dự báo × ASP lịch sử
	measure 'DSS Revenue Baseline' =
			VAR f = [DSS S6 Forecast Units]
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), f * asp)
		formatString: $#,0
		displayFolder: 8. DSS S5/S6
		lineageTag: 881da78d-2e49-40db-a472-d1f09987334a

	/// S6 – doanh thu kịch bản theo Demand Change; không nhân Safety Factor
	measure 'DSS Revenue Scenario' =
			VAR f = [DSS S6 Forecast Units]
			VAR asp = CALCULATE([ASP for Member], fact_demand_forecast[level] = "company")
			RETURN IF([DSS S6 Eligible] <> 1, BLANK(), f * (1 + [Demand Change Value]) * asp)
		formatString: $#,0
		displayFolder: 8. DSS S5/S6
		lineageTag: 2d2482ec-32d6-419e-bac5-a83c97ba90af

	/// S6 – chênh lệch doanh thu Scenario – Baseline
	measure 'DSS Revenue Delta' = IF([DSS S6 Eligible] <> 1, BLANK(), [DSS Revenue Scenario] - [DSS Revenue Baseline])
		formatString: +$#,0;-$#,0;$0
		displayFolder: 8. DSS S5/S6
		lineageTag: ec665f8e-0cb8-40c1-bc38-ce9b898fb787

	/// TC-S5-01: sản lượng thực bán cùng hãng, cùng tháng năm trước
	measure 'TC S5 01 PY Units' =
			VAR ym = [DSS Selected Forecast Month]
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(ym), BLANK(),
			    CALCULATE(
			        SUM(fact_car_sales[quantity]),
			        REMOVEFILTERS(dim_month), REMOVEFILTERS(dim_year),
			        REMOVEFILTERS(dim_calendar), REMOVEFILTERS(dim_date),
			        dim_date[year] = INT((ym - 100) / 100),
			        dim_date[month] = MOD(ym, 100)
			    )
			)
		formatString: #,0
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 9d0be9b5-57a9-45ac-8719-05010e10ea90

	/// TC-S5-01: Growth đối chiếu = (Forecast - PY) / PY
	measure 'TC S5 01 Expected Growth' =
			VAR f = [DSS Forecast Units Company]
			VAR py = [TC S5 01 PY Units]
			RETURN IF(ISBLANK(f) || ISBLANK(py) || py <= 0, BLANK(), DIVIDE(f - py, py))
		formatString: 0.0%
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: bb20e8c0-6619-4dff-b72b-f2d8e684da42

	/// TC-S5-01: đối chiếu Growth; ví dụ Mercedes-B tại hình 12
	measure 'TC S5 01 Status' =
			VAR actual = [Priority Growth Raw]
			VAR expected = [TC S5 01 Expected Growth]
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || ISBLANK(expected), "NO DATA",
			    IF(NOT ISBLANK(actual) && ABS(actual - expected) <= 0.000001, "PASS", "FAIL")
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 1b40713d-5991-49ed-84c6-f53bcd1e8081

	/// TC-S5-02: bốn điểm của hãng hợp lệ nằm trong [0,1], hình 13
	measure 'TC S5 02 Status' =
			VAR g = [Priority Growth Score]
			VAR s = [Priority Share Score]
			VAR st = [Priority Stability Score]
			VAR a = [Priority Accuracy Score]
			RETURN IF(
			    NOT HASONEVALUE(dim_car[company]) || [Priority Eligible] <> 1, "NO DATA",
			    IF(NOT ISBLANK(g) && NOT ISBLANK(s) && NOT ISBLANK(st) && NOT ISBLANK(a)
			        && g >= 0 && g <= 1 && s >= 0 && s <= 1
			        && st >= 0 && st <= 1 && a >= 0 && a <= 1, "PASS", "FAIL")
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: a69903af-9a05-4b0a-bfaa-a8c8004956bb

	/// TC-S5-03: chọn 50/25/25/25 để kiểm tra 40/20/20/20%, hình 14
	measure 'TC S5 03 Status' = IF(SELECTEDVALUE(Param_Growth[Value], 25) <> 50 || SELECTEDVALUE(Param_Share[Value], 25) <> 25 || SELECTEDVALUE(Param_Stability[Value], 25) <> 25 || SELECTEDVALUE(Param_Accuracy[Value], 25) <> 25, "N/A", IF(NOT ISBLANK([Priority Weight Growth]) && ABS([Priority Weight Growth] - 0.4) <= 0.000001 && NOT ISBLANK([Priority Weight Share]) && ABS([Priority Weight Share] - 0.2) <= 0.000001 && NOT ISBLANK([Priority Weight Stability]) && ABS([Priority Weight Stability] - 0.2) <= 0.000001 && NOT ISBLANK([Priority Weight Accuracy]) && ABS([Priority Weight Accuracy] - 0.2) <= 0.000001, "PASS", "FAIL"))
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: a7089a97-d224-41b3-bc2d-60eb071b9966

	/// TC-S5-04: bốn trọng số 0 tự trở về 25% mỗi tiêu chí, hình 15
	measure 'TC S5 04 Status' = IF(SELECTEDVALUE(Param_Growth[Value], 25) <> 0 || SELECTEDVALUE(Param_Share[Value], 25) <> 0 || SELECTEDVALUE(Param_Stability[Value], 25) <> 0 || SELECTEDVALUE(Param_Accuracy[Value], 25) <> 0, "N/A", IF(NOT ISBLANK([Priority Weight Growth]) && ABS([Priority Weight Growth] - 0.25) <= 0.000001 && NOT ISBLANK([Priority Weight Share]) && ABS([Priority Weight Share] - 0.25) <= 0.000001 && NOT ISBLANK([Priority Weight Stability]) && ABS([Priority Weight Stability] - 0.25) <= 0.000001 && NOT ISBLANK([Priority Weight Accuracy]) && ABS([Priority Weight Accuracy] - 0.25) <= 0.000001, "PASS", "FAIL"))
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 0b9604f2-5832-4353-85c1-407484f07101

	/// TC-S6-05: đối soát trực tiếp fact theo member/tháng/model, company, không backtest
	measure 'TC S6 05 Expected Forecast' =
			VAR ym = [DSS Selected Forecast Month]
			VAR mdl = [DSS Selected Forecast Model]
			VAR memberName = SELECTEDVALUE(fact_demand_forecast[member])
			RETURN IF(
			    ISBLANK(ym) || ISBLANK(mdl) || ISBLANK(memberName), BLANK(),
			    CALCULATE(
			        SUM(fact_demand_forecast[forecast_units]),
			        REMOVEFILTERS(dim_month), REMOVEFILTERS(dim_year),
			        REMOVEFILTERS(dim_calendar), REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(fact_demand_forecast),
			        fact_demand_forecast[month_id] = ym,
			        fact_demand_forecast[model_name] = mdl,
			        fact_demand_forecast[level] = "company",
			        fact_demand_forecast[is_backtest] = FALSE(),
			        TREATAS({memberName}, fact_demand_forecast[member])
			    )
			)
		formatString: #,0.00
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 35b75bb3-ea77-4c29-847d-f7036a4154d0

	/// TC-S6-01: d=0, k=1; Baseline=Scenario, Delta=0, hình 16
	measure 'TC S6 01 Status' =
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			VAR ob = [DSS Order Baseline]
			VAR os = [DSS Order Scenario]
			VAR rb = [DSS Revenue Baseline]
			VAR rs = [DSS Revenue Scenario]
			VAR deltaO = [DSS Order Delta]
			VAR deltaR = [DSS Revenue Delta]
			RETURN SWITCH(
			    TRUE(),
			    NOT HASONEVALUE(fact_demand_forecast[member]) || [DSS S6 Eligible] <> 1, "NO DATA",
			    ABS(d - (0)) > 0.000001 || ABS(k - 1) > 0.000001, "N/A",
			    ISBLANK(ob) || ISBLANK(os) || ISBLANK(rb) || ISBLANK(rs)
			        || ISBLANK(deltaO) || ISBLANK(deltaR), "FAIL",
			    ABS(deltaO - (os - ob)) > 0.000001 || ABS(deltaR - (rs - rb)) > 1, "FAIL",
			    ABS(os - ob) <= 0.000001 && ABS(rs - rb) <= 1 && ABS(deltaO) <= 0.000001 && ABS(deltaR) <= 1, "PASS",
			    "FAIL"
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 502f68ad-5000-4f78-9405-971ad0a80257

	/// TC-S6-02: d=+20%, k=1; doanh thu x1.2, xe nhập không giảm, hình 17
	measure 'TC S6 02 Status' =
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			VAR ob = [DSS Order Baseline]
			VAR os = [DSS Order Scenario]
			VAR rb = [DSS Revenue Baseline]
			VAR rs = [DSS Revenue Scenario]
			VAR deltaO = [DSS Order Delta]
			VAR deltaR = [DSS Revenue Delta]
			RETURN SWITCH(
			    TRUE(),
			    NOT HASONEVALUE(fact_demand_forecast[member]) || [DSS S6 Eligible] <> 1, "NO DATA",
			    ABS(d - (0.2)) > 0.000001 || ABS(k - 1) > 0.000001, "N/A",
			    ISBLANK(ob) || ISBLANK(os) || ISBLANK(rb) || ISBLANK(rs)
			        || ISBLANK(deltaO) || ISBLANK(deltaR), "FAIL",
			    ABS(deltaO - (os - ob)) > 0.000001 || ABS(deltaR - (rs - rb)) > 1, "FAIL",
			    os >= ob && ABS(rs - 1.2 * rb) <= 1, "PASS",
			    "FAIL"
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 5876bae0-7998-4536-8b19-ee7b55c0849e

	/// TC-S6-03: d=-20%, k=1; doanh thu x0.8, xe nhập không tăng, hình 18
	measure 'TC S6 03 Status' =
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			VAR ob = [DSS Order Baseline]
			VAR os = [DSS Order Scenario]
			VAR rb = [DSS Revenue Baseline]
			VAR rs = [DSS Revenue Scenario]
			VAR deltaO = [DSS Order Delta]
			VAR deltaR = [DSS Revenue Delta]
			RETURN SWITCH(
			    TRUE(),
			    NOT HASONEVALUE(fact_demand_forecast[member]) || [DSS S6 Eligible] <> 1, "NO DATA",
			    ABS(d - (-0.2)) > 0.000001 || ABS(k - 1) > 0.000001, "N/A",
			    ISBLANK(ob) || ISBLANK(os) || ISBLANK(rb) || ISBLANK(rs)
			        || ISBLANK(deltaO) || ISBLANK(deltaR), "FAIL",
			    ABS(deltaO - (os - ob)) > 0.000001 || ABS(deltaR - (rs - rb)) > 1, "FAIL",
			    os <= ob && ABS(rs - 0.8 * rb) <= 1, "PASS",
			    "FAIL"
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 9a4bf12b-0160-49f2-8320-3c1315f0ff2e

	/// TC-S6-04: d=0, k=2; xe nhập không giảm, doanh thu giữ nguyên, hình 19
	measure 'TC S6 04 Status' =
			VAR d = [Demand Change Value]
			VAR k = [Safety Factor Value]
			VAR ob = [DSS Order Baseline]
			VAR os = [DSS Order Scenario]
			VAR rb = [DSS Revenue Baseline]
			VAR rs = [DSS Revenue Scenario]
			VAR deltaO = [DSS Order Delta]
			VAR deltaR = [DSS Revenue Delta]
			RETURN SWITCH(
			    TRUE(),
			    NOT HASONEVALUE(fact_demand_forecast[member]) || [DSS S6 Eligible] <> 1, "NO DATA",
			    ABS(d - (0)) > 0.000001 || ABS(k - 2) > 0.000001, "N/A",
			    ISBLANK(ob) || ISBLANK(os) || ISBLANK(rb) || ISBLANK(rs)
			        || ISBLANK(deltaO) || ISBLANK(deltaR), "FAIL",
			    ABS(deltaO - (os - ob)) > 0.000001 || ABS(deltaR - (rs - rb)) > 1, "FAIL",
			    os >= ob && ABS(rs - rb) <= 1, "PASS",
			    "FAIL"
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 908a25e3-a94e-40e1-b844-95d51e85fff2

	/// TC-S6-05: đúng một hãng/tháng/model khi đổi bộ lọc, hình 20-22
	measure 'TC S6 05 Status' =
			VAR actual = [DSS S6 Forecast Units]
			VAR expected = [TC S6 05 Expected Forecast]
			RETURN IF(
			    NOT HASONEVALUE(fact_demand_forecast[member]) || ISBLANK(expected), "NO DATA",
			    IF(NOT ISBLANK(actual) && ABS(actual - expected) <= 0.000001, "PASS", "FAIL")
			)
		displayFolder: 9. Testcase theo báo cáo
		lineageTag: 3faefab9-ce6a-455c-ac5f-cb61446a8587

	column 'Value'
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]
		lineageTag: ab846c30-38f0-49e5-8446-fa38bb69a31c

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", 0 )
