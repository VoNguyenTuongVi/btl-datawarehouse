	/// D12–D17
	measure 'Dim Revenue YoY %' =
			VAR _t = FILTER ( kpi_monthly_by_dimension, NOT ISBLANK ( kpi_monthly_by_dimension[revenue_py] ) )
			VAR _cur = SUMX ( _t, kpi_monthly_by_dimension[revenue] )
			VAR _base = SUMX ( _t, kpi_monthly_by_dimension[revenue_py] )
			RETURN DIVIDE ( _cur - _base, _base )
		formatString: 0.0%
		displayFolder: 2. Theo chiều phân tích
