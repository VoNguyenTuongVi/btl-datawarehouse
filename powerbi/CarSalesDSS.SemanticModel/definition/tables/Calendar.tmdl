table Calendar
	dataCategory: Time
	lineageTag: e89ab5e0-eadb-4c9b-85c5-9b17b83172a9

	column 'Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		isKey
		isNameInferred
		sourceColumn: [Date]
		lineageTag: 7c632e71-cc18-46f5-920f-73a746edf166

	column 'Year'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]
		lineageTag: 162b0374-634b-4440-9f86-fbbbbfaa45e3

	column 'Quarter'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]
