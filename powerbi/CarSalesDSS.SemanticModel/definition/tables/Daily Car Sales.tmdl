table 'Daily Car Sales'
	lineageTag: cb58a1ef-a3be-4ce7-b338-cf53683e6cc4

	column 'Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]
		lineageTag: 4dacd7c8-ffc3-4a15-82f4-4f59bfd4037b

	column 'company'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [company]
		lineageTag: c4c2ce48-b5f3-4b7f-9fbc-279224ef9bde

	column 'model'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [model]
		lineageTag: 64f693a1-d410-49f7-8c20-4a52a1190414

	column 'engine'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [engine]
		lineageTag: 8e90fa1c-2635-4b9b-a179-2622ba5d8ff7

	column 'transmission'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [transmission]
		lineageTag: 5458c5f4-77ed-4a89-9bd3-d677951a1e8b

	column 'color'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [color]
		lineageTag: 03eb545f-cb8c-4a1d-acb2-af697cc6e833

	column 'body_style'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [body_style]
		lineageTag: 8c3c1ce7-bf14-47f6-a7ee-badb758c768a

	column 'Units Qty'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Units Qty]
		lineageTag: bd936c54-e3fe-49ce-9b7a-e90eb50a700a

	column 'Sales Amount'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Sales Amount]
		lineageTag: bbfacb85-3cc8-4157-a4a4-4b17e415edf1

	partition 'Daily Car Sales' = calculated
		mode: import
		source =
				SUMMARIZECOLUMNS (
				    Calendar[Date],
				    dim_car[company],
				    dim_car[model],
				    dim_car[engine],
				    dim_car[transmission],
				    dim_car[color],
				    dim_car[body_style],
				    "Units Qty", SUM ( fact_car_sales[quantity] ),
				    "Sales Amount", SUM ( fact_car_sales[price] )
				)
