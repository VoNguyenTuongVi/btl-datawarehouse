# Copy this file to .env and fill in real values. Never commit .env.
# Giá trị trong .env LUÔN được ưu tiên hơn biến môi trường cùng tên
# (kể cả biến còn sót từ $env:DATABASE_URL=... hoặc setx), xem src/env_config.py.
# Mật khẩu có ký tự đặc biệt thì mã hóa URL: @ -> %40, # -> %23, % -> %25, / -> %2F
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/car_sales_dw
